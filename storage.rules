rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function belongsToTenant(tenantId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/users/$(request.auth.uid));
    }

    match /tenants/{tenantId}/receipts/{fileName=**} {
      allow read, write: if belongsToTenant(tenantId);
    }

    match /tenants/{tenantId}/purchases/{fileName=**} {
      allow read: if belongsToTenant(tenantId);
      allow write: if belongsToTenant(tenantId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/.*)');
    }
  }
}
