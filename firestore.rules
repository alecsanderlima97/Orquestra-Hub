rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isPlatformOwner() { return signedIn() && request.auth.token.email == 'limaalecsander@gmail.com'; }

    function belongsToTenant(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid));
    }
    function role(tenantId) { return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.role; }
    function canWrite(tenantId) { return isPlatformOwner() || (belongsToTenant(tenantId) && role(tenantId) in ['Dono', 'Financeiro']); }
    function isOwner(tenantId) { return isPlatformOwner() || (belongsToTenant(tenantId) && role(tenantId) == 'Dono'); }

    match /tenants/{tenantId} {
      allow read: if belongsToTenant(tenantId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(tenantId);
      allow delete: if false;

      match /users/{userId} {
        allow read: if belongsToTenant(tenantId);
        allow create: if signedIn() && request.auth.uid == userId
          && (get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid
            || (exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.tenantId == tenantId
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.status == 'Ativo'
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time));
        allow update: if isOwner(tenantId) || (request.auth.uid == userId && request.resource.data.role == resource.data.role);
      }

      match /auditLogs/{logId} { allow read: if isOwner(tenantId); allow create: if canWrite(tenantId); allow update, delete: if false; }

      match /{document=**} {
        allow read: if belongsToTenant(tenantId);
        allow write: if canWrite(tenantId);
      }
    }

    match /userTenants/{userId}/memberships/{tenantId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(userId));
      allow update, delete: if false;
    }

    match /invites/{code} {
      allow read: if signedIn() && (resource.data.tenantId == null || isOwner(resource.data.tenantId) || resource.data.status == 'Ativo');
      allow create: if signedIn() && isOwner(request.resource.data.tenantId);
      allow update: if signedIn() && (
        isOwner(resource.data.tenantId)
        || (resource.data.status == 'Ativo'
          && request.resource.data.status == 'Usado'
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.role == resource.data.role)
      );
      allow delete: if false;
    }
  }
}
