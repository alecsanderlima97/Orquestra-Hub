rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isPlatformOwner() { return signedIn() && request.auth.token.email == 'limaalecsander@gmail.com'; }

    function belongsToTenant(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid));
    }
    function role(tenantId) { return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.role; }
    function isTenantOwner(tenantId) {
      return signedIn()
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid;
    }
    function hasActiveInvite(code, tenantId) {
      return exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.status == 'Ativo'
        && get(/databases/$(database)/documents/invites/$(code)).data.expiresAt > request.time
        && (get(/databases/$(database)/documents/invites/$(code)).data.inviteType == 'commercial'
          || get(/databases/$(database)/documents/invites/$(code)).data.tenantId == tenantId);
    }
    function canWrite(tenantId) { return isPlatformOwner() || isTenantOwner(tenantId) || (belongsToTenant(tenantId) && role(tenantId) in ['Proprietário', 'Dono', 'Financeiro']); }
    function isOwner(tenantId) { return isPlatformOwner() || isTenantOwner(tenantId) || (belongsToTenant(tenantId) && role(tenantId) in ['Proprietário', 'Dono']); }

    match /tenants/{tenantId} {
      allow read: if isPlatformOwner() || belongsToTenant(tenantId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isPlatformOwner() || isOwner(tenantId))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aiCredits']);
      allow delete: if false;

      match /users/{userId} {
        allow read: if belongsToTenant(tenantId);
        allow create: if signedIn() && request.auth.uid == userId
          && (isPlatformOwner()
            || get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid
            || hasActiveInvite(request.resource.data.inviteCode, tenantId));
        allow update: if isOwner(tenantId) || (request.auth.uid == userId && request.resource.data.role == resource.data.role);
      }

      match /auditLogs/{logId} { allow read: if isOwner(tenantId); allow create: if canWrite(tenantId); allow update, delete: if false; }
      match /privacyRequests/{requestId} { allow read: if isOwner(tenantId) || resource.data.userId == request.auth.uid; allow create: if belongsToTenant(tenantId) && request.resource.data.userId == request.auth.uid; allow update, delete: if false; }

      match /{document=**} {
        allow read: if belongsToTenant(tenantId);
        allow write: if canWrite(tenantId);
      }
    }

    match /userTenants/{userId}/memberships/{tenantId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && (exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(userId))
          || get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid
          || hasActiveInvite(request.resource.data.inviteCode, tenantId));
      allow update: if signedIn()
        && request.auth.uid == userId
        && isOwner(tenantId)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /invites/{code} {
      allow read: if signedIn() && (resource.data.status == 'Ativo' || resource.data.tenantId == null || isOwner(resource.data.tenantId));
      allow create: if signedIn() && (isPlatformOwner() || isOwner(request.resource.data.tenantId));
      allow update: if signedIn() && (
        isPlatformOwner()
        || (resource.data.tenantId != null && isOwner(resource.data.tenantId))
        || (resource.data.status == 'Ativo'
          && request.resource.data.status == 'Usado'
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.role == resource.data.role)
      );
      allow delete: if false;
    }
  }
}
