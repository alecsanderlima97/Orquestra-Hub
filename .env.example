# Mercado Pago billing provider (server-only; never expose in NEXT_PUBLIC_ variables)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=https://hub.orquestracs.com/api/billing/mercadopago/webhook

# Portal Orquestra.cs connector (server-only; never use NEXT_PUBLIC_ variables)
ORQUESTRA_PORTAL_CONNECTOR_URL=https://portal.orquestracs.com/api/connectors/snapshot
ORQUESTRA_CONNECTOR_SHARED_SECRET=

# URL pública da tela de pagamentos do Portal; não contém segredo
NEXT_PUBLIC_ORQUESTRA_PORTAL_PAYMENTS_URL=https://portal.orquestracs.com/pagamentos

# URL pública da Central Admin do Portal; não contém segredo
NEXT_PUBLIC_ORQUESTRA_PORTAL_ADMIN_URL=https://portal.orquestracs.com/central-admin
